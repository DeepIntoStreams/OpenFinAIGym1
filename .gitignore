*.ipynb

# Auto-pipeline staging outputs (contents ignored, .gitkeep tracked)
/data/pipeline_output/papers/*
!/data/pipeline_output/papers/.gitkeep
/data/pipeline_output/datasets/*
!/data/pipeline_output/datasets/.gitkeep
/data/pipeline_output/.staging
/data/pipeline_output/.cache
/data/pipeline_output/rewards/*
!/data/pipeline_output/rewards/.gitkeep
/data/pipeline_output/logs/*
!/data/pipeline_output/logs/.gitkeep

# Runtime + training artifacts (contents ignored, .gitkeep tracked for runtime dirs)
/data/run_output/verifier/*
!/data/run_output/verifier/.gitkeep
/data/run_output/examples/*
!/data/run_output/examples/.gitkeep
/data/run_output/realtime_diagnostics/*
!/data/run_output/realtime_diagnostics/.gitkeep
/data/run_output/jobs/*
!/data/run_output/jobs/.gitkeep
/data/run_output/sft_dataset/
/data/run_output/checkpoints/

# tasks/: track only offline_*, realtime_*, _template, the empty generated/ marker,
# and the curated task-paper matrix doc.
/tasks/*
!/tasks/offline_*/
!/tasks/realtime_*/
!/tasks/_template/
!/tasks/generated/
!/tasks/curated_task_paper_matrix.md
/tasks/generated/*
!/tasks/generated/.gitkeep

# Legacy paths (may still exist during transition)
/data/knowledge_base/papers
/data/knowledge_base/datasets
/data/knowledge_base/rewards/generated
/data/knowledge_base/.staging
/data/results

# Caches
/data/.cache
/.claude

CLAUDE.md

