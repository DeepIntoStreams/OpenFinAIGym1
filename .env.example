# OpenFinGym — root environment variable reference
# Copy to .env and fill in required values.

# ── LLM providers (pipeline only) ──────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AWS_PROFILE=
AWS_REGION=us-east-1
OLLAMA_BASE_URL=http://localhost:11434

# ── Data collection (pipeline only) ────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=    # optional; higher rate limits
CROSSREF_MAILTO=              # optional; polite pool access

# ── Dataset download providers (pipeline corpus) ─────────────────
KAGGLE_USERNAME=             # optional; required for Kaggle downloads
KAGGLE_KEY=                  # optional; required for Kaggle downloads
HF_TOKEN=                    # optional; token for gated or rate-limited Hugging Face downloads
HUGGINGFACE_HUB_TOKEN=       # optional; alternative Hugging Face token variable
FRED_API_KEY=                # optional; required for FRED API endpoints, not always needed for public St. Louis Fed static files
GITHUB_TOKEN=

# ── Pipeline path overrides (optional) ────────────────────────────
FIN_PIPELINE_CONFIG=          # default: config/base.yaml
FIN_PIPELINE_SCOPES=          # default: config/scopes.yaml
FIN_PIPELINE_DATA_ROOT=       # default: ./data  (project root; contains knowledge_base/, benchmark/, results/, .cache/)

# ── Live trading evaluation (live-predict, live-resolve) ─────────
ALPACA_API_KEY=              # optional; required for Alpaca US equity data
ALPACA_SECRET_KEY=           # optional; required for Alpaca US equity data

# ── Harbor runtime (harbor only) ──────────────────────────────────
# LiteLLM picks up OPENAI_API_KEY / ANTHROPIC_API_KEY / AWS_* above
