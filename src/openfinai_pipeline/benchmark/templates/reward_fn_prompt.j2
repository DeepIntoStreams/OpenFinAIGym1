=== EXAMPLE 1: Forecasting reward (gt captured at init) ===

class MSELoss(Loss):
    """Mean squared error between predicted and target."""
    def __init__(self, gt, name="test"):
        super().__init__(name=name)
        self.gt = gt.float()

    def forward(self, pred):
        return ((pred.float() - self.gt) ** 2).mean()

=== EXAMPLE 2: Generative pair-distance reward (real captured at init) ===

class MeanLoss(Loss):
    """L1 distance between mean of generated and real samples along (0, 1)."""
    def __init__(self, gt, name="test"):
        super().__init__(name=name)
        self.real_mean = gt.float().mean((0, 1))

    def forward(self, pred):
        return torch.abs(pred.float().mean((0, 1)) - self.real_mean).mean()

=== EXAMPLE 3: Generative single-fake reward (no reference needed) ===

class IntraClassDispersionLoss(Loss):
    """Intra-class dispersion of generated samples — no reference needed."""
    def forward(self, pred):
        flat = pred.reshape(pred.shape[0], -1)
        centred = flat - flat.mean(0, keepdim=True)
        return centred.pow(2).mean()

=== EXAMPLE 4: Embedding-pair reward (model-free FID-style) ===

class EmbeddingFID(Loss):
    """Frechet distance on precomputed embeddings."""
    def __init__(self, real_emb, name="test"):
        super().__init__(name=name)
        self.mu_real = real_emb.float().mean(0).detach()

    def forward(self, fake_emb):
        mu_fake = fake_emb.float().mean(0)
        return ((mu_fake - self.mu_real) ** 2).sum()

=== EXAMPLE 5: Forecasting reward with hyperparameter ===

class HuberLoss(Loss):
    """Huber loss with configurable delta hyperparameter."""
    def __init__(self, gt, delta=1.0, name="test"):
        super().__init__(name=name)
        self.gt = gt.float()
        self.delta = float(delta)

    def forward(self, pred):
        diff = pred.float() - self.gt
        absdiff = diff.abs()
        quadratic = torch.minimum(absdiff, torch.tensor(self.delta, dtype=diff.dtype, device=diff.device))
        linear = absdiff - quadratic
        return (0.5 * quadratic ** 2 + self.delta * linear).mean()

=== REWARD SHAPES (pick one based on the target reward) ===

Choose ONE shape based on what your metric needs from ctx:

- Forecasting / pair-distance:
    __init__(self, gt, ...): captures ground truth at init
    forward(self, pred):     consumes the agent's prediction
- Generative single-fake (no reference data needed):
    forward(self, pred):     no __init__ override required
- Embedding pair (model-free FID/KID substitute):
    __init__(self, real_emb, ...): captures real-side embeddings
    forward(self, fake_emb):       consumes agent embeddings
- Probabilistic / multi-sample agent forecasts (CRPS-like):
    __init__(self, gt, ...):
    forward(self, pred_samples):

