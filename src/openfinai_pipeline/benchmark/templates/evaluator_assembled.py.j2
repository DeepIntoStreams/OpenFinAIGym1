"""
Evaluator for {{ title }}.

Deterministically assembled from the reward bank.
Rewards resolved: {{ rewards_resolved | join(', ') }}

This module is self-contained: all reward classes it imports come from
``task_rewards.py`` next to this file (bundled at install time by
``openfinai_pipeline.benchmark.install.reward_bundler``). It does not
depend on the Harbor base image's ``/openfinai/eval/`` path.

Held-out test ground truth is loaded from a verifier-only HDF5
artifact (``test_ground_truth.h5``) that lives outside the agent's
``/data/`` mount — see ``_load_reference_data`` below.
"""
import importlib.util
import inspect
import json
import os
import sys
from pathlib import Path
from typing import Any, Dict

import h5py
import numpy as np
import torch

# The bundled ``task_rewards.py`` lives next to this evaluator inside
# the installed task package. We load it with ``importlib.util`` and a
# unique synthetic module name (suffixed by the file path's hash) so
# multiple installed tasks can coexist in the same Python process —
# notably during pipeline tests where many evaluators are exercised
# back-to-back. A naive ``from task_rewards import X`` would hit the
# ``sys.modules`` cache and return whichever task_rewards.py imported
# first, producing confusing ImportError surprises.
_self_dir = Path(__file__).resolve().parent
_task_rewards_path = _self_dir / "task_rewards.py"
if not _task_rewards_path.exists():
    raise ImportError(
        f"task_rewards.py not found next to {Path(__file__).name} at "
        f"{_task_rewards_path}. The install-time reward bundler must "
        "produce this file; reinstall via the openfinai_pipeline "
        "benchmark builder."
    )
_task_rewards_modname = f"_task_rewards_{abs(hash(str(_task_rewards_path)))}"
_task_rewards_spec = importlib.util.spec_from_file_location(
    _task_rewards_modname, str(_task_rewards_path)
)
if _task_rewards_spec is None or _task_rewards_spec.loader is None:
    raise ImportError(
        f"could not build import spec for {_task_rewards_path}"
    )
_task_rewards = importlib.util.module_from_spec(_task_rewards_spec)
sys.modules[_task_rewards_modname] = _task_rewards
_task_rewards_spec.loader.exec_module(_task_rewards)

{% for imp in bundled_imports %}
{{ imp.class_name }} = _task_rewards.{{ imp.class_name }}
{% endfor %}

try:
    from openfinai_pipeline.benchmark.contracts import BaseEvaluator
except Exception:
    class BaseEvaluator:
        REWARD_NAMES: list[str] = []


# Canonical ctx-key set: parameter names in metric signatures that bind
# directly to runtime ctx tensors. Mirrors
# ``openfinai_pipeline.prompts.canonical_ctx`` but baked in here so the
# assembled evaluator is self-contained and doesn't need pipeline imports
# at runtime.
_CANONICAL_CTX_KEYS: frozenset[str] = frozenset(
    {{ canonical_ctx_keys | tojson }}
)

# Adjacent framework whitelist: kwargs callers may pass via ``score()`` that
# are not canonical ctx keys but feed task-specific dispatch paths.
# TradingReward classes consume the raw list[dict] objects via the bare
# ``predictions`` / ``ground_truths`` parameter names; ``trade_*`` aliases
# are kept for backward compat with code that explicitly addressed those
# keys.
_FRAMEWORK_KWARG_KEYS: tuple[str, ...] = (
    "predictions",
    "ground_truths",
    "trade_predictions",
    "trade_ground_truths",
    "conf",
)

# Reward specs — baked in at assembly time. Param-name → ctx-key wiring is
# implicit in the signatures imported above; runtime introspection resolves
# kwargs from ctx by parameter name. Only ``params`` (per-task hyperparameter
# overrides) and ``base_class`` (Loss vs TradingReward dispatch) survive
# from the legacy envelope.
_REWARD_SPECS: list[Dict[str, Any]] = [
{%- for m in reward_specs %}
    {
        "reward_key": "{{ m.reward_key }}",
        "class_name": "{{ m.class_name }}",
        "base_class": "{{ m.base_class }}",
        "params": {{ m.final_params | tojson }},
    },
{%- endfor %}
]

_CLASS_REGISTRY: dict[str, type] = {
{%- for m in reward_specs %}
    "{{ m.reward_key }}": {{ m.class_name }},
{%- endfor %}
}


class {{ class_name }}Evaluator(BaseEvaluator):
    """
    Standalone evaluator for {{ title }}.

    Assembled from the reward bank. Each metric's parameter names are
    canonical ctx keys; the runtime introspects ``__init__`` and
    ``forward`` signatures to bind tensors from ctx by name. Metric
    instances are cached on first ``score()`` call (paying any heavy
    reference-stat init exactly once).
    """

    EXPECTS_PREDICTIONS = False
    # For auto-pipeline forecasting/generative tasks, a held-out test
    # ground_truth is ALWAYS expected to be present at evaluation time
    # — it lives in ``/eval-data/test_ground_truth.h5`` (verifier-only
    # mount) and ``_load_reference_data`` reads it via h5py. Trading
    # and reference-shape unconditional generative are scored without
    # a separate held-out artifact and override this flag downstream.
    EXPECTS_GROUND_TRUTH = True
    REWARD_NAMES: list[str] = [
{%- for m in reward_specs %}
        "{{ m.reward_key }}",
{%- endfor %}
    ]
    _INTERACTION_MODEL = "{{ interaction_model }}"
    _DATASET_PAYLOAD_FILES: list[str] = {{ dataset_payload_files | tojson }}
    _EXPECTED_AGENT_OUTPUTS: list[str] = {{ expected_agent_outputs | tojson }}
    # Default location of the held-out test ground_truth artifact at
    # evaluation time. ``score()`` accepts an explicit ``eval_data_dir``
    # kwarg; this constant is the fallback when the kwarg is absent.
    # ``OPENFINAI_EVAL_DATA_DIR`` env var overrides at runtime if set.
    _DEFAULT_EVAL_DATA_DIR: str = "/eval-data"
    _TEST_GT_FILENAME: str = "test_ground_truth.h5"
    # Whether this task has a held-out test target is determined at
    # runtime from ``dataset.h5``'s root ``shape`` attr (see
    # :meth:`_has_held_out_gt`). The slicer writes that attr atomically
    # alongside the file, so the runtime read can never disagree with
    # the on-disk reality — unlike the previous baked-at-assembly-time
    # literal which derived from a corpus-phase guess about the dataset
    # rather than the loader's actual output.
    _MANIFEST_STATUS: str = "{{ manifest_status }}"

    def __init__(self) -> None:
        self._metrics: dict[str, Any] = {}
        self._metric_errors: dict[str, str] = {}
        self._metrics_built = False

    # Payload loading

    @staticmethod
    def _load_array_file(path: Path) -> Any:
        if path.suffix == ".npy":
            return np.load(str(path))
        if path.suffix == ".npz":
            data = np.load(str(path))
            return data[list(data.files)[0]]
        if path.suffix == ".csv":
            return np.loadtxt(str(path), delimiter=",", skiprows=1, encoding="utf-8")
        raise ValueError(f"Unsupported array file: {path}")

    @classmethod
    def _existing_payload_paths(cls, data_dir: Path) -> list[Path]:
        paths: list[Path] = []
        for rel_path in cls._DATASET_PAYLOAD_FILES:
            candidate = data_dir / rel_path
            if candidate.exists():
                paths.append(candidate)
        return paths

    @classmethod
    def _has_held_out_gt(cls, data_dir: Path | str | None) -> bool:
        """Whether this task ships a held-out test target.

        Reads ``dataset.h5``'s root ``shape`` attr — written by the
        install slicer (``b_shape`` for forecasting / conditional
        generative; ``reference`` for unconditional generative) — and
        returns ``False`` only when the attr is explicitly
        ``"reference"``. The slicer is the only writer of both the
        file and the attr, so the runtime read is the canonical
        predicate; it cannot disagree with the on-disk reality the way
        a baked-at-assembly-time literal derived from a corpus-phase
        guess could.

        Falls back to ``True`` when ``dataset.h5`` is absent, the attr
        is missing, or the attr is some unexpected value — those
        paths are reached only by hand-rolled test fixtures that
        never went through the slicer (or by older slicer outputs
        that pre-date the attr). The legacy default keeps those
        callers' "we expect held-out GT" assumption working.
        """
        if data_dir is None:
            return True
        try:
            with h5py.File(Path(data_dir) / "dataset.h5", "r") as f:
                shape_attr = f.attrs.get("shape", None)
                if shape_attr is None:
                    return True
                return str(shape_attr) != "reference"
        except (OSError, KeyError):
            return True

    @classmethod
    def _resolve_eval_data_dir(
        cls,
        eval_data_dir: Path | str | None,
        data_dir: Path | None,
    ) -> Path | None:
        """Pick the verifier-only mount where ``test_ground_truth.h5`` lives.

        Priority: explicit ``eval_data_dir`` kwarg → ``OPENFINAI_EVAL_DATA_DIR``
        env var → the constant ``_DEFAULT_EVAL_DATA_DIR`` (``/eval-data`` for
        Harbor) → a sibling ``../eval-data`` of ``data_dir`` (helpful for
        dry-fire and tests, where the install layout is reproduced under
        a tmp_path). Returns ``None`` when no candidate exists.
        """
        candidates: list[Path] = []
        if eval_data_dir is not None:
            candidates.append(Path(str(eval_data_dir)).resolve())
        env_dir = os.environ.get("OPENFINAI_EVAL_DATA_DIR")
        if env_dir:
            candidates.append(Path(env_dir).resolve())
        candidates.append(Path(cls._DEFAULT_EVAL_DATA_DIR).resolve())
        if data_dir is not None:
            candidates.append((Path(data_dir).resolve().parent / "eval-data"))
        for c in candidates:
            if c.is_dir() and (c / cls._TEST_GT_FILENAME).is_file():
                return c
        return None

    @classmethod
    def _load_reference_data(
        cls,
        data_dir: Path,
        eval_data_dir: Path | str | None = None,
    ) -> Any:
        """Read the held-out test ground truth from ``test_ground_truth.h5``.

        The verifier mounts ``/eval-data/`` separately from ``/data/``;
        the agent's container does not have read access to it. This
        function reads the HDF5 file at
        ``<eval_data_dir>/test_ground_truth.h5`` directly via h5py and
        returns the reconstructed ndarray (single-symbol) or
        ``{sym: ndarray}`` dict (panel case).

        For unconditional generative tasks (``shape="reference"`` in
        ``dataset.h5``'s root attrs) :meth:`_has_held_out_gt` returns
        ``False`` and this method short-circuits — the agent and
        verifier read the same reference distribution via ``load.py``
        and the synthesised zero placeholder in :meth:`score` becomes
        the GT slot.
        """
        if not cls._has_held_out_gt(data_dir):
            # Unconditional generative: no held-out artifact to load.
            # Caller falls back to ``_synth_ground_truth_placeholder``.
            return None
        resolved = cls._resolve_eval_data_dir(eval_data_dir, data_dir)
        if resolved is None:
            print(
                f"[evaluator] could not locate {cls._TEST_GT_FILENAME} "
                f"under any of: explicit eval_data_dir, "
                f"OPENFINAI_EVAL_DATA_DIR env, {cls._DEFAULT_EVAL_DATA_DIR}, "
                f"or {data_dir}/../eval-data. The verifier mount may not "
                "be wired correctly.",
                file=sys.stderr,
            )
            return None
        gt_path = resolved / cls._TEST_GT_FILENAME
        try:
            with h5py.File(gt_path, "r") as f:
                if "ground_truth" not in f:
                    print(
                        f"[evaluator] {gt_path}: missing required "
                        "'/ground_truth' group",
                        file=sys.stderr,
                    )
                    return None
                gt_node = f["ground_truth"]
                if not isinstance(gt_node, h5py.Group):
                    print(
                        f"[evaluator] {gt_path}: '/ground_truth' must be a "
                        "group; got "
                        f"{type(gt_node).__name__}",
                        file=sys.stderr,
                    )
                    return None
                keys = list(gt_node.keys())
                if keys == ["_value"]:
                    return np.asarray(gt_node["_value"][...])
                out: dict[str, Any] = {}
                for key in keys:
                    item = gt_node[key]
                    if not isinstance(item, h5py.Dataset):
                        print(
                            f"[evaluator] {gt_path}: '/ground_truth/{key}' "
                            "must be a dataset",
                            file=sys.stderr,
                        )
                        return None
                    out[key] = np.asarray(item[...])
                return out
        except Exception as exc:  # noqa: BLE001 — surface details to stderr
            print(
                f"[evaluator] failed to read {gt_path}: "
                f"{type(exc).__name__}: {exc}",
                file=sys.stderr,
            )
            return None

    def _synth_ground_truth_placeholder(self, predictions: Any) -> Any:
        """Placeholder GT for the no-GT fallback code path."""
        try:
            arr = np.asarray(predictions, dtype=np.float64)
            return np.zeros_like(arr)
        except Exception:
            return predictions

    @classmethod
    def _load_agent_predictions(cls, agent_output_dir: Path) -> Any:
        candidates: list[str] = list(cls._EXPECTED_AGENT_OUTPUTS)
        if cls._INTERACTION_MODEL == "forecasting":
            candidates.extend(["output.npy", "output.csv", "results.npy", "results.csv"])
        elif cls._INTERACTION_MODEL == "generative":
            candidates.extend(["predictions.npy", "predictions.csv", "output.npy", "output.csv", "results.npy", "results.csv"])
        seen: set[str] = set()
        for name in candidates:
            if name in seen:
                continue
            seen.add(name)
            path = agent_output_dir / name
            if not path.exists():
                continue
            try:
                return cls._load_array_file(path)
            except Exception:
                continue
        return None

    # Dispatch by canonical signature names

    @staticmethod
    def _resolve_signature_kwargs(
        fn: Any,
        ctx: Dict[str, Any],
        params_override: Dict[str, Any],
    ) -> Dict[str, Any]:
        """Build kwargs for *fn* by walking its signature.

        For each non-self parameter, prefer ``params_override`` (per-task
        hyperparameter), then ctx (canonical-name binding), then leave it
        out and let the function's own default apply. Required params with
        no source raise ``KeyError`` so ``score()`` surfaces the error in
        ``scores["_errors"]`` instead of silently NaN-ing.
        """
        sig = inspect.signature(fn)
        out: Dict[str, Any] = {}
        for name, param in sig.parameters.items():
            if name == "self":
                continue
            if param.kind in (
                inspect.Parameter.VAR_POSITIONAL,
                inspect.Parameter.VAR_KEYWORD,
            ):
                continue
            if name in params_override:
                out[name] = params_override[name]
                continue
            if name in ctx:
                out[name] = ctx[name]
                continue
            if param.default is inspect.Parameter.empty:
                raise KeyError(
                    f"required param {name!r} of {getattr(fn, '__qualname__', fn)} "
                    "is missing from ctx and params_override"
                )
            # else: leave it; the function's own default applies.
        return out

    def _ensure_metrics(self, ctx: Dict[str, Any]) -> None:
        """Lazy-build metric instances on first use."""
        if self._metrics_built:
            return
        for spec in _REWARD_SPECS:
            key = spec["reward_key"]
            cls = _CLASS_REGISTRY.get(key)
            if cls is None:
                self._metric_errors[key] = "class not imported"
                continue
            try:
                init_kwargs = self._resolve_signature_kwargs(
                    cls.__init__, ctx, dict(spec["params"])
                )
                # ``name`` is the Loss-base identifier kwarg; only set it
                # when the constructor actually takes it.
                if spec["base_class"] != "TradingReward":
                    sig = inspect.signature(cls.__init__)
                    if (
                        "name" in sig.parameters
                        and "name" not in init_kwargs
                    ):
                        init_kwargs["name"] = spec["class_name"]
                self._metrics[key] = cls(**init_kwargs)
            except Exception as exc:  # noqa: BLE001 — want full surface
                self._metric_errors[key] = f"{type(exc).__name__}: {exc}"
        self._metrics_built = True

    def _score_failure(
        self,
        reward_output: str | Path | None,
        error: str,
    ) -> Dict[str, float]:
        scores: Dict[str, Any] = {name: float("nan") for name in self.REWARD_NAMES}
        scores["reward"] = 0.0
        scores["_error"] = error
        scores["_errors"] = dict(self._metric_errors)
        if reward_output is not None:
            out = Path(reward_output)
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(json.dumps(scores, indent=2))
        return scores

    def score(
        self,
        predictions: Any,
        ground_truth: Any,
        weights: list[float] | None = None,
        reward_output: str | Path | None = None,
        **kwargs: Any,
    ) -> Dict[str, float]:
        """
        Score predictions against ground truth via signature introspection.

        Args:
            predictions:  Model predictions (array-like). Maps to ``ctx["pred"]``.
            ground_truth: Ground truth values (array-like). Maps to ``ctx["gt"]``.
            weights:      Per-reward scalars following ``REWARD_NAMES`` order.
                          Defaults to equal weights of 1.0 each.
            reward_output: If provided, write ``reward.json`` to this path.
            **kwargs:     Additional ctx tensors keyed by canonical name
                          (e.g. ``pred_samples``, ``real_emb``, ``fake_emb``,
                          ``gt_samples``) plus framework kwargs
                          (``trade_predictions``, ``trade_ground_truths``,
                          ``conf``). Anything else is ignored.
                          ``agent_output_dir``, ``data_dir``, and
                          ``eval_data_dir`` are reserved for on-disk
                          payload lookup. The verifier's held-out test
                          ground_truth is loaded from
                          ``<eval_data_dir>/test_ground_truth.h5``
                          unless an explicit ``ground_truth`` argument
                          is supplied.

        Returns:
            Dict mapping each reward key to its float score, plus:
            ``"reward"`` — weighted total (NaN entries excluded);
            ``"_errors"`` — dict of reward_key -> error message, per-metric.
        """
        agent_output_dir = (
            Path(str(kwargs.get("agent_output_dir", ""))).resolve()
            if kwargs.get("agent_output_dir")
            else None
        )
        data_dir = (
            Path(str(kwargs.get("data_dir", ""))).resolve()
            if kwargs.get("data_dir")
            else None
        )
        eval_data_dir_kw = kwargs.get("eval_data_dir")
        eval_data_dir = (
            Path(str(eval_data_dir_kw)).resolve()
            if eval_data_dir_kw
            else None
        )
        if predictions is None and agent_output_dir is not None:
            predictions = self._load_agent_predictions(agent_output_dir)
        if ground_truth is None:
            ground_truth = self._load_reference_data(
                data_dir if data_dir is not None else Path.cwd(),
                eval_data_dir=eval_data_dir,
            )
        if predictions is None:
            return self._score_failure(reward_output, "No compatible agent output found")
        if ground_truth is None:
            gt_data_dir = data_dir if data_dir is not None else Path.cwd()
            if not type(self)._has_held_out_gt(gt_data_dir):
                ground_truth = self._synth_ground_truth_placeholder(predictions)
            else:
                return self._score_failure(
                    reward_output, "No compatible reference payload found"
                )

        # Build canonical context, retaining raw objects when tensor conversion fails.
        ctx: Dict[str, Any] = {}
        try:
            ctx["pred"] = torch.as_tensor(
                np.asarray(predictions, dtype=np.float64), dtype=torch.float32
            )
        except Exception:
            ctx["pred"] = predictions
        try:
            ctx["gt"] = torch.as_tensor(
                np.asarray(ground_truth, dtype=np.float64), dtype=torch.float32
            )
        except Exception:
            ctx["gt"] = ground_truth
        # TradingReward classes consume the raw untouched objects via
        # ``predictions`` / ``ground_truths`` parameter names. Alias under
        # ``trade_*`` kept for backward compat with explicit override
        # callers.
        ctx["predictions"] = predictions
        ctx["ground_truths"] = ground_truth
        ctx["trade_predictions"] = predictions
        ctx["trade_ground_truths"] = ground_truth

        # Pass through any additional canonical-key kwargs (e.g. real_emb,
        # fake_emb, pred_samples, gt_samples) and adjacent framework kwargs.
        # ``agent_output_dir``, ``data_dir``, ``eval_data_dir`` are reserved
        # for on-disk lookup and never enter ctx.
        for key, value in kwargs.items():
            if key in ("agent_output_dir", "data_dir", "eval_data_dir"):
                continue
            if key in _CANONICAL_CTX_KEYS or key in _FRAMEWORK_KWARG_KEYS:
                ctx[key] = value

        self._ensure_metrics(ctx)

        scores: Dict[str, Any] = {}
        errors: Dict[str, str] = dict(self._metric_errors)
        for spec in _REWARD_SPECS:
            key = spec["reward_key"]
            scores[key] = float("nan")
            metric = self._metrics.get(key)
            if metric is None:
                continue
            try:
                if spec["base_class"] == "TradingReward":
                    fwd_kwargs = self._resolve_signature_kwargs(
                        metric.compute_aggregate, ctx, {}
                    )
                    result = metric.compute_aggregate(**fwd_kwargs)
                    scores[key] = float(result)
                else:
                    fwd_kwargs = self._resolve_signature_kwargs(
                        metric.forward, ctx, {}
                    )
                    result = metric(**fwd_kwargs)
                    if hasattr(result, "item"):
                        scores[key] = float(result.item())
                    else:
                        scores[key] = float(result)
            except Exception as exc:  # noqa: BLE001 — want full surface
                errors[key] = f"{type(exc).__name__}: {exc}"
                scores[key] = float("nan")

        # Weighted total
        reward_names = self.REWARD_NAMES
        if weights is None:
            weights = [1.0] * len(reward_names)
        combined = 0.0
        for name, w in zip(reward_names, weights):
            value = scores.get(name, float("nan"))
            if not isinstance(value, (int, float)) or not np.isfinite(value):
                continue
            combined += value * w
        scores["reward"] = combined

        if errors:
            scores["_errors"] = errors

        print(f"\n{'Reward':<35} {'Score':>12} {'Weight':>10}")
        print("-" * 59)
        for name, w in zip(reward_names, weights):
            value = scores.get(name, float("nan"))
            if isinstance(value, (int, float)):
                print(f"  {name:<33} {value:>12.6f} {w:>10.4f}")
            else:
                print(f"  {name:<33} {str(value):>12} {w:>10.4f}")
        print("-" * 59)
        print(f"  {'weighted total':<33} {combined:>12.6f}")

        if reward_output is not None:
            out = Path(reward_output)
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(json.dumps(scores, indent=2, default=str))
            print(f"\nReward output written to {out}")

        return scores
